{
  "manifest_version": 3,
  "name": "Dairy R&D Department Briefing",
  "version": "1.1.2",
  "description": "Daily 4:00 PM IST Chrome briefing for your dairy R&D department. Today if anything new, otherwise yesterday.",
  "homepage_url": "https://github.com/Jinius007/Dairy-R-D-Scouting",
  "action": {
    "default_title": "Dairy R&D briefing",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["alarms", "notifications", "storage"],
  "host_permissions": [
    "https://raw.githubusercontent.com/Jinius007/Dairy-R-D-Scouting/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
